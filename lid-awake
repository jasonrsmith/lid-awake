#!/usr/bin/env bash
# lid-awake: toggle a mode where closing the lid turns the screen off
# but does NOT suspend, so agents/builds keep running.
#   lid-awake on | off | status | toggle
set -u
UNIT=lid-awake  # transient systemd --user unit holding the inhibitor
LID=$(ls -d /proc/acpi/button/lid/*/ | head -1)state
BL=$(ls /sys/class/backlight | head -1)

set_brightness() {
  busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness ssu backlight "$BL" "$1" >/dev/null 2>&1
}

watch_lid() {
  local saved="" state
  trap '[ -n "$saved" ] && set_brightness "$saved"; exit 0' TERM INT
  while :; do
    state=$(awk '{print $2}' "$LID")
    if [ "$state" = closed ] && [ -z "$saved" ]; then
      saved=$(cat /sys/class/backlight/$BL/brightness)
      set_brightness 0
    elif [ "$state" = open ] && [ -n "$saved" ]; then
      set_brightness "$saved"; saved=""
    fi
    sleep 1
  done
}

running() { systemctl --user is-active --quiet "$UNIT"; }

notify() { command -v notify-send >/dev/null && notify-send -a "Lid Awake" "$1"; echo "$1"; }

case "${1:-toggle}" in
  _watch) watch_lid ;;
  on)
    running && { echo "already on"; exit 0; }
    # Own unit, so it survives the terminal/tray that started it.
    systemd-run --user --quiet --collect --unit="$UNIT" \
      systemd-inhibit --what=handle-lid-switch:sleep --who="lid-awake" \
      --why="Keep running with lid closed" --mode=block \
      "$(readlink -f "$0")" _watch
    notify "Lid-awake ON: closing the lid will only turn off the screen" ;;
  off)
    systemctl --user stop "$UNIT" 2>/dev/null
    notify "Lid-awake OFF: closing the lid suspends normally" ;;
  status) running && echo on || echo off ;;
  toggle) running && "$0" off || "$0" on ;;
  *) echo "usage: lid-awake on|off|status|toggle"; exit 1 ;;
esac
